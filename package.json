{
  "name": "pop-agent",
  "private": true,
  "version": "0.2.9",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "shared",
    "server",
    "web",
    "cli"
  ],
  "scripts": {
    "dev": "npm run build -w shared && tsx watch server/src/main.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b && npm run typecheck -w @pop-agent/web && tsc --noEmit -p tools",
    "test": "vitest run",
    "build": "tsc -b && chmod +x server/dist/manager/main.js && npm run build -w @pop-agent/web",
    "gate": "tsx tools/gate-receipt.ts begin && npm run selfmap:check && npm run lint && npm run typecheck && npm run build && npm run test && npm run smoke && tsx tools/gate-receipt.ts complete",
    "selfmap": "tsx tools/generate-self-map.ts",
    "ui:crawl": "tsx tools/ui-crawl.ts",
    "selfmap:check": "tsx tools/generate-self-map.ts --check",
    "safety:scan": "tsx tools/safety-scan.ts .",
    "smoke": "tsx tools/smoke.ts",
    "pack:cli": "tsx tools/pack-cli.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.0.0",
    "happy-dom": "^20.11.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "sharp": "^0.35.3",
    "ws": "^8.21.1"
  },
  "overrides": {
    "@huggingface/transformers": {
      "sharp": "0.35.3"
    }
  }
}
