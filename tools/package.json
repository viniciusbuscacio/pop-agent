{
  "name": "pop-agent",
  "private": true,
  "version": "0.2.24",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run build -w shared && tsx watch server/src/main.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b && npm run typecheck -w @pop-agent/web && tsc --noEmit -p tools",
    "test": "vitest run",
    "build": "tsc -b && npm run build -w @pop-agent/web",
    "gate": "npm run selfmap:check && npm run lint && npm run typecheck && npm run build && npm run test && npm run smoke",
    "selfmap": "tsx tools/generate-self-map.ts",
    "ui:crawl": "tsx tools/ui-crawl.ts",
    "selfmap:check": "tsx tools/generate-self-map.ts --check",
    "smoke": "tsx tools/smoke.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.0.0",
    "happy-dom": "^20.11.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.0.0"
  }
}
