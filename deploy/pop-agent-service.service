# Development unit for the test server (ubuntu-home): keeps the dev server up
# across reboots so the tailnet URL always answers. Runs the TypeScript sources
# through tsx -- no build step -- which is what makes it a *dev* unit; the
# production unit will point at the compiled dist/ instead.
#
# ExecStart is fully absolute on purpose: systemd starts with a minimal PATH at
# boot, so `npx` (or a bare `node`) resolves unreliably there. Paths assume the
# clone lives at /home/vinicius/dev/pop-agent on the test server.
#
# EnvironmentFile carries the provider key. The leading `-` means the unit
# still starts when the file is absent, which is the normal state of a fresh
# clone: no key simply means no provider is configured yet.
#
# Install:  sudo cp deploy/pop-agent-service.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now pop-agent-service

[Unit]
Description=Pop Agent dev server (tsx, sources from ~/dev/pop-agent)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vinicius
WorkingDirectory=/home/vinicius/dev/pop-agent
EnvironmentFile=-/home/vinicius/dev/pop-agent/.env
# pi's catalog refresh runs without a network timeout; one stalled fetch used
# to hold the OAuth login promise hostage (08/08). Offline mode keeps that
# bookkeeping local -- model catalogs arrive with pi upgrades instead.
Environment=PI_OFFLINE=1
ExecStart=/usr/bin/node /home/vinicius/dev/pop-agent/node_modules/tsx/dist/cli.mjs server/src/main.ts
Restart=on-failure
RestartSec=2
# Bound a pathological provider response or retry loop before journald's global
# retention policy has to intervene. Normal Pop traffic is far below this.
LogRateLimitIntervalSec=30s
LogRateLimitBurst=500

[Install]
WantedBy=multi-user.target
